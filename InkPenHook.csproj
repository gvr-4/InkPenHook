<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>InkPenHook_Icon_16-256.ico</ApplicationIcon>
	<Description>for Dynabook V8 StylusPen(WACOM AES2)
I created this with a lot of help from Google Gemini. Thanks!</Description>
	<Configurations>Debug;Release</Configurations>

	<!-- ビルド日時をリビジョンIDとして埋め込む -->
	<SourceRevisionId>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ssZ"))</SourceRevisionId>

  </PropertyGroup>

	<Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
		<PropertyGroup>
			<!-- WPF等の一時プロジェクトビルド時は、元のプロジェクト名（MSBuildProjectFile）から拡張子を除いて取得 -->
			<RealProjectName Condition="'$(MSBuildProjectExtension)' == '.csproj'">$(MSBuildProjectName)</RealProjectName>
			<RealProjectName Condition="'$(MSBuildProjectExtension)' != '.csproj'">$([System.IO.Path]::GetFileNameWithoutExtension($(MSBuildProjectFile)))</RealProjectName>

			<BuildInfoClass>
				<![CDATA[
namespace System
{
    public static class BuildInfo
    {
        public const string ProjectName = "$(RealProjectName)"%3B
        public const string Configuration = "$(Configuration)"%3B
        public const string Platform = "$(Platform)"%3B
    }
}
    ]]>
			</BuildInfoClass>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="$(BuildInfoClass)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <None Remove="20260907 構成ファイル案.txt" />
	  <None Remove="2026_09_06_日.txt" />
	  <None Remove="2026_09_08_火.txt" />
	  <None Remove="2026_09_08_火_16_44_17.txt" />
	  <None Remove="InkPenHook_Icon_16-256.ico" />
	  <None Remove="InkPenHook_Icon_256.ico" />
	</ItemGroup>

	<ItemGroup>
	  <Page Remove="InkPenHook.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="InkPenHook.xaml">
	    <Generator>MSBuild:Compile</Generator>
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="InkPenHook_Icon_16-256.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
	  <Page Update="MainWindow.xaml">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Page>
	</ItemGroup>

</Project>
